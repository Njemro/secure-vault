# Secure Vault - local development environment variables
#
# Copy this file to ".env" and adjust the values. The real ".env" is
# git-ignored and must never be committed.
# The values below are placeholders for local development only.

# Database name and credentials for the MySQL container
MYSQL_DATABASE=secure_vault
MYSQL_USER=secure_vault
MYSQL_PASSWORD=dev_only_change_me
MYSQL_ROOT_PASSWORD=dev_only_change_me_root

# Connection settings for the Spring Boot backend (used in later tasks)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/secure_vault
SPRING_DATASOURCE_USERNAME=secure_vault
SPRING_DATASOURCE_PASSWORD=dev_only_change_me

# Keycloak container bootstrap administrator (console login)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev_only_change_me_keycloak

KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/secure-vault