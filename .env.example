# Secure Vault local development environment.
# Never commit this file. Replace every CHANGE_ME value before running.

MYSQL_DATABASE=secure_vault
MYSQL_USER=secure_vault_app
MYSQL_PASSWORD=dev_only_change_me
MYSQL_ROOT_PASSWORD=dev_only_change_me_root

# Keycloak bootstrap admin: used only when the Keycloak data volume is first created.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_before_starting_keycloak

# Public realm endpoints used by backend JWT validation and Gateway OIDC.
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=secure-vault
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/secure-vault
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8080/realms/secure-vault/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/secure-vault/protocol/openid-connect/token
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/secure-vault/protocol/openid-connect/certs
KEYCLOAK_USER_INFO_URI=http://localhost:8080/realms/secure-vault/protocol/openid-connect/userinfo

# Backend Keycloak Admin API service account (secure-vault-admin).
# Regenerate this secret in Keycloak because the previous ZIP exposed it.
KEYCLOAK_ADMIN_CLIENT_ID=secure-vault-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=paste_new_secure_vault_admin_client_secret

# Gateway OIDC BFF client (secure-vault-bff); secret is server-side only.
KEYCLOAK_BFF_CLIENT_ID=secure-vault-bff
KEYCLOAK_BFF_CLIENT_SECRET=paste_secure_vault_bff_client_secret
OIDC_REDIRECT_URI=http://localhost:5173/login/oauth2/code/keycloak
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login?logged_out
OIDC_TOKEN_REFRESH_CLOCK_SKEW_SECONDS=5

# Keycloak realm access-token lifespan used by scripts/set-keycloak-access-token-lifespan.sh.
# Set to 60 for rotation testing; increase to e.g. 300 for normal development.
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_SECONDS=60

# Gateway / Redis (host-run Gateway connects to local Compose Redis).
GATEWAY_REDIS_HOST=localhost
GATEWAY_REDIS_PORT=6379
GATEWAY_API_URI=http://localhost:8081
GATEWAY_RATE_LIMIT_REPLENISH_RATE=10
GATEWAY_RATE_LIMIT_BURST_CAPACITY=20
GATEWAY_REGISTER_RATE_LIMIT_REPLENISH_RATE=1
GATEWAY_REGISTER_RATE_LIMIT_BURST_CAPACITY=5
